{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oiof/schemas/automation_blueprint.schema.json",
  "title": "Automation Blueprint",
  "description": "Logical schema for the human-in-the-loop workflow design produced by prompts/03_automation_blueprint.md (examples/automation_blueprint.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "triggers",
    "input_sources",
    "deterministic_checks",
    "llm_tasks",
    "prohibited_autonomous_actions",
    "human_approval_gates",
    "escalation_conditions",
    "timeout_paths",
    "audit_record_fields",
    "retention_days",
    "owner_role",
    "success_criteria"
  ],
  "properties": {
    "workflow_id": { "type": "string" },
    "triggers": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "input_sources": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "validation_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deterministic_checks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Checks that must be performed by non-LLM code, not left to model judgment."
    },
    "llm_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "prohibited_autonomous_actions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Actions this workflow must never take without a human approval step."
    },
    "human_approval_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_name", "approver_role", "trigger_condition"],
        "properties": {
          "gate_name": { "type": "string" },
          "approver_role": {
            "type": "string",
            "not": { "pattern": "(?i).*\\b(ai|artificial intelligence|llm|language model|the model|assistant|claude|chatgpt|gpt-[0-9]+)\\b.*" }
          },
          "trigger_condition": { "type": "string" }
        }
      }
    },
    "escalation_conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exception_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timeout_paths": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Behavior when an approval gate is not answered by its deadline. Must always describe an escalation, never a silent auto-approval."
    },
    "rollback_considerations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "audit_record_fields": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1
    },
    "owner_role": {
      "type": "string",
      "not": { "pattern": "(?i).*\\b(ai|artificial intelligence|llm|language model|the model|assistant|claude|chatgpt|gpt-[0-9]+)\\b.*" }
    },
    "observability_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "mvp_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "future_state_scope": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
